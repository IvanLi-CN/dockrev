FROM rust:1.91-bookworm AS builder
WORKDIR /src

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY src ./src
COPY web/public ./web/public

RUN cargo build -p dockrev-api --release

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=builder /src/target/release/dockrev /usr/local/bin/dockrev

EXPOSE 50883
CMD ["/usr/local/bin/dockrev"]
