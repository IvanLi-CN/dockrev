{
  "name": "dockrev",
  "private": true,
  "scripts": {
    "hooks:install": "bash scripts/install-hooks.sh",
    "bootstrap:worktree": "bash scripts/bootstrap-worktree.sh",
    "test:worktree-bootstrap": "bash scripts/test-worktree-bootstrap.sh",
    "docs:dev": "DOCS_PORT=${DOCS_PORT:-50885} bun run --cwd docs-site dev",
    "docs:build": "bun run --cwd docs-site build",
    "docs:preview": "DOCS_PORT=${DOCS_PORT:-50885} bun run --cwd docs-site preview"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "commitlint-plugin-function-rules": "^4.0.2"
  }
}
