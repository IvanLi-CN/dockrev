{
  "schema_version": 2,
  "baseline": {
    "source": "github-final-release",
    "base_branch": "main"
  },
  "source_ci_workflow": "CI (main)",
  "intents": [
    "major",
    "minor",
    "patch",
    "alpha",
    "beta",
    "rc"
  ],
  "exact_version": {
    "stable": "X.Y.Z",
    "prerelease": [
      "X.Y.Z-alpha.N",
      "X.Y.Z-beta.N",
      "X.Y.Z-rc.N"
    ],
    "build_metadata": false,
    "v_prefix": false
  },
  "prerelease_channels": [
    "alpha",
    "beta",
    "rc"
  ],
  "prerelease_sequence_start": 1,
  "prerelease_transitions": [
    "stable:alpha,beta,rc",
    "alpha:alpha,beta",
    "beta:beta,rc",
    "rc:rc,stable"
  ],
  "publication": {
    "stable": {
      "github_release": true,
      "ghcr_version": true,
      "ghcr_source_sha": true,
      "ghcr_latest": true
    },
    "prerelease": {
      "github_prerelease": true,
      "ghcr_version": true,
      "ghcr_source_sha": true,
      "ghcr_latest": false
    }
  }
}
