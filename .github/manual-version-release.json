{
  "schema_version": 1,
  "baseline": {
    "ref": "main",
    "file": "VERSION"
  },
  "intents": [
    "major",
    "minor",
    "patch",
    "alpha",
    "beta",
    "rc"
  ],
  "exact_version": {
    "stable": "X.Y.Z",
    "prerelease": [
      "X.Y.Z-alpha.N",
      "X.Y.Z-beta.N",
      "X.Y.Z-rc.N"
    ],
    "build_metadata": false,
    "v_prefix": false
  },
  "prerelease_channels": [
    "alpha",
    "beta",
    "rc"
  ],
  "prerelease_sequence_start": 1,
  "prerelease_transitions": [
    "alpha:alpha,beta",
    "beta:beta,rc",
    "rc:rc,stable"
  ],
  "identity": {
    "changed_files": [
      "VERSION"
    ],
    "signed": true,
    "immutable_version_reservation": true,
    "preparation_branch_prefix": "release-preparation/v",
    "reservation_branch_prefix": "release-reservation/v"
  },
  "publication": {
    "stable": {
      "github_release": true,
      "ghcr_version": true,
      "ghcr_latest": true
    },
    "prerelease": {
      "github_prerelease": true,
      "ghcr_version": true,
      "ghcr_latest": false
    }
  }
}
