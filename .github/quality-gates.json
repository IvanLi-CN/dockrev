{
  "schema_version": 1,
  "policy": {
    "baseline_policy": "explicit-waiver-required",
    "require_signed_commits": true,
    "branch_protection": {
      "protected_branches": ["main"],
      "require_pull_request": true,
      "disallow_direct_pushes": true,
      "require_merge_queue": false
    },
    "review_policy": {
      "mode": "conditional-required",
      "required_approvals": 1,
      "exempt_repository_owner": true,
      "exempt_author_permissions": ["admin", "maintain"],
      "allowed_reviewer_permissions": ["write", "maintain", "admin"],
      "enforcement": {"mode": "required-check", "check_name": "Review Policy Gate"}
    }
  },
  "required_checks": ["Review Policy Gate", "Label Gate", "Release completion"],
  "release_label_contract": {
    "policy_file": ".github/pr-label-release.json",
    "supported_channels": ["stable", "beta", "rc", "dev"],
    "promotion_sequence": ["beta", "rc", "stable"]
  },
  "informational_checks": [
    "Detect changes", "Lint & Checks", "Worktree bootstrap smoke", "Backend Tests",
    "Frontend lint + build", "Frontend Storybook build", "Frontend Storybook test",
    "Deploy Smoke", "Release build check (PR)"
  ],
  "waivers": [],
  "expected_pr_workflows": [
    {"workflow": "Review Policy", "jobs": ["Review Policy Gate"]},
    {"workflow": "Label Gate", "jobs": ["Label Gate"]},
    {"workflow": "Release Preparation", "jobs": ["Prepare PR VERSION identity"]},
    {"workflow": "Release completion", "jobs": ["Release completion"]},
    {"workflow": "CI (PR)", "jobs": ["Detect changes", "Lint & Checks", "Worktree bootstrap smoke", "Backend Tests", "Deploy Smoke", "Frontend lint + build", "Frontend Storybook build", "Frontend Storybook test", "Release build check (PR)"]}
  ]
}
