{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun ./node_modules/.bin/vite",
    "demo:app": "DOCKREV_WEB_BASE=/demo/ DOCKREV_PWA=off VITE_DOCKREV_PWA=off VITE_DOCKREV_DEMO=app bun --bun ./node_modules/.bin/vite --host 127.0.0.1",
    "build": "bun test && bun --bun ./node_modules/.bin/tsc -b && bun --bun ./node_modules/.bin/vite build",
    "postbuild": "if command -v python3 >/dev/null 2>&1; then bun run test:pwa-assets; else echo 'PWA asset contract skipped: python3 is unavailable'; fi",
    "build:demo:pages": "bun --bun ./node_modules/.bin/tsc -b && DOCKREV_PWA=off VITE_DOCKREV_PWA=off VITE_DOCKREV_DEMO=app bun --bun ./node_modules/.bin/vite build",
    "test": "bun test",
    "test:pwa-assets": "python3 scripts/check-pwa-assets.py",
    "test:pwa-update": "node ./scripts/test-pwa-update.mjs",
    "lint": "bun --bun ./node_modules/.bin/eslint .",
    "storybook": "bun ./scripts/storybook-dev.mjs",
    "storybook:start": "bun ./scripts/storybook-daemon.mjs start",
    "storybook:stop": "bun ./scripts/storybook-daemon.mjs stop",
    "storybook:status": "bun ./scripts/storybook-daemon.mjs status",
    "storybook:logs": "bun ./scripts/storybook-daemon.mjs logs",
    "storybook:screenshots": "bun ./scripts/capture-storybook-screenshots.mjs",
    "build-storybook": "node ./scripts/storybook-build.mjs",
    "test-storybook": "bun ./scripts/test-storybook.mjs",
    "preview": "bun --bun ./node_modules/.bin/vite preview"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@iconify-icons/mdi": "^1.2.48",
    "@iconify/react": "^6.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.13.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@mdx-js/react": "^3.1.1",
    "@storybook/addon-docs": "10.1.11",
    "@storybook/react": "^10.1.11",
    "@storybook/react-vite": "^10.1.11",
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.57.0",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-plugin-pwa": "^1.1.0"
  }
}
